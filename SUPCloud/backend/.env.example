PORT=3000
DATABASE_URL="postgresql://user:password@localhost:5432/supcloud?schema=public"
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:5173
# Origines autorisées par CORS (séparées par des virgules) ; par défaut : FRONTEND_URL
CORS_ORIGINS=http://localhost:5173
# Dossier de stockage des fichiers ; par défaut : backend/uploads
UPLOAD_DIR=./uploads
# Taille maximale d'un fichier en octets ; par défaut : 30 Go (le quota reste la vraie limite)
# MAX_FILE_SIZE_BYTES=30000000000

# OAuth2 Google
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# OAuth2 GitHub
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_CALLBACK_URL=http://localhost:3000/auth/github/callback

# OAuth2 Microsoft (Azure AD)
MICROSOFT_CLIENT_ID=your_microsoft_client_id
MICROSOFT_CLIENT_SECRET=your_microsoft_client_secret
MICROSOFT_CALLBACK_URL=http://localhost:3000/auth/microsoft/callback
MICROSOFT_TENANT_ID=common
