# Réglages FACULTATIFS de « docker compose up » : copier ce fichier en .env pour les utiliser.
# Sans .env, l'application démarre avec les valeurs par défaut ci-dessous.
# Ce fichier ne doit contenir aucun secret réel dans le dépôt : .env est ignoré par Git.

# Ports publiés sur la machine hôte
FRONTEND_PORT=5173
BACKEND_PORT=3000

# Adresse du frontend (redirections après connexion OAuth2, CORS) ; par défaut http://localhost:<FRONTEND_PORT>
# FRONTEND_URL=http://localhost:5173
# Adresse du backend vue par le navigateur ; changer cette valeur oblige à reconstruire l'image du frontend :
# docker compose up --build
# VITE_API_URL=http://localhost:3000

# Clé de signature des jetons de connexion. Par défaut elle est générée au premier démarrage et conservée
# dans un volume : à ne définir que pour imposer sa propre valeur (au moins 32 caractères aléatoires).
# JWT_SECRET=
# JWT_EXPIRES_IN=7d

# Connexion OAuth2 (facultative : sans identifiants, le bouton correspondant est désactivé).
# Adresses de retour à déclarer chez chaque fournisseur : http://localhost:<BACKEND_PORT>/auth/<fournisseur>/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_TENANT_ID=common
